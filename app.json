{
  "expo": {
    "name": "khumaar",
    "slug": "khumaar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "khumaar",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.bitsrain.khumaar",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Khumaar uses your camera for cosmetic skin coaching scans. Photos stay private to your account.",
        "NSLocationWhenInUseUsageDescription": "Khumaar uses your location to show local UV and environment coaching.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Khumaar uses your location to show local UV and environment coaching."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.bitsrain.khumaar",
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Khumaar uses your camera for cosmetic skin coaching scans. Photos stay private to your account.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/lufga/Lufga-Light.ttf",
            "./assets/fonts/lufga/Lufga-LightItalic.ttf",
            "./assets/fonts/lufga/Lufga-Regular.ttf",
            "./assets/fonts/lufga/Lufga-Italic.ttf",
            "./assets/fonts/lufga/Lufga-Medium.ttf",
            "./assets/fonts/lufga/Lufga-MediumItalic.ttf",
            "./assets/fonts/lufga/Lufga-SemiBold.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F1F2",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-image",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Khumaar uses your location to show local UV and environment coaching."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
