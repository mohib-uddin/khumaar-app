{
  "expo": {
    "name": "khumaar",
    "slug": "khumaar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "khumaar",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.bitsrain.khumaar"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.bitsrain.khumaar"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/lufga/Lufga-Light.ttf",
            "./assets/fonts/lufga/Lufga-LightItalic.ttf",
            "./assets/fonts/lufga/Lufga-Regular.ttf",
            "./assets/fonts/lufga/Lufga-Italic.ttf",
            "./assets/fonts/lufga/Lufga-Medium.ttf",
            "./assets/fonts/lufga/Lufga-MediumItalic.ttf",
            "./assets/fonts/lufga/Lufga-SemiBold.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F1F2",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
